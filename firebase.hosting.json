{
  "hosting": {
    "site": "orthoharness",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "archive/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/check",
        "destination": "https://decisionindex.com/ortho",
        "type": 301
      },
      {
        "regex": "^/([^.]+)$",
        "destination": "https://decisionindex.com/ortho",
        "type": 301
      },
      {
        "regex": "^/(.+)\\.html$",
        "destination": "https://decisionindex.com/ortho",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          }
        ]
      }
    ]
  }
}
