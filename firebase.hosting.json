{
  "hosting": {
    "site": "orthoharness",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "archive/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/check",
        "destination": "https://decisionindex.com/ortho",
        "type": 301
      },
      {
        "regex": "^/([^.]+)$",
        "destination": "https://decisionindex.com/ortho",
        "type": 301
      },
      {
        "regex": "^/(.+)\\.html$",
        "destination": "https://decisionindex.com/ortho",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'sha256-iUWRJMkhNg8U8pHBPok4HMAEsTS25k+x1qc+WmpxXYk='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://solvinghealth.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'self'; form-action 'self'; base-uri 'self'; object-src 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          }
        ]
      }
    ]
  }
}
